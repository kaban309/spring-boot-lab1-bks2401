# Скопируйте этот файл в .env и впишите свои значения. Файл .env НЕ коммитится в git.
DB_URL=jdbc:postgresql://localhost:5432/garden
DB_USER=garden_app
DB_PASSWORD=change_me_strong_password

# Секретный ключ подписи JWT (HS256): не менее 32 случайных байт в Base64. Сгенерируйте СВОЙ и не публикуйте:
#   Linux/macOS:  openssl rand -base64 32
#   Windows PowerShell:
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# При смене ключа все ранее выданные токены перестанут действовать.
JWT_SECRET=replace_with_generated_base64_key
